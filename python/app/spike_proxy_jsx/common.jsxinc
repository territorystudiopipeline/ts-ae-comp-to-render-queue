// SPIKE helpers (no JSON object in older ExtendScript)
// Something in this After Effects adds a "unique_id" function to Object.prototype, so every
// for-in loop must skip inherited keys and functions.
function spKeys(obj) {
    var keys = [];
    for (var k in obj) {
        if (!obj.hasOwnProperty(k)) continue;
        if (typeof obj[k] === "function") continue;
        keys.push(k);
    }
    return keys;
}
function spEsc(s) {
    return String(s).replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\r/g, "\\r").replace(/\n/g, "\\n");
}
function spSer(v, depth) {
    depth = depth || 0;
    if (v === null || v === undefined) return "null";
    var t = typeof v;
    if (t === "number") return isFinite(v) ? String(v) : '"' + String(v) + '"';
    if (t === "boolean") return String(v);
    if (t === "string") return '"' + spEsc(v) + '"';
    if (t === "function") return "null";
    if (depth > 5) return '"<deep>"';
    if (v instanceof Array) {
        var a = [];
        for (var i = 0; i < v.length; i++) a.push(spSer(v[i], depth + 1));
        return "[" + a.join(",") + "]";
    }
    if (t === "object" && (v.constructor === Object)) {
        var parts = [], keys = spKeys(v);
        for (var n = 0; n < keys.length; n++) {
            var k = keys[n];
            try { parts.push('"' + spEsc(k) + '":' + spSer(v[k], depth + 1)); } catch (e) {}
        }
        return "{" + parts.join(",") + "}";
    }
    return '"' + spEsc(String(v)) + '"';
}
function spWrite(path, value) {
    var f = new File(path);
    f.encoding = "UTF-8";
    if (!f.open("w")) throw new Error("Can't write " + path);
    f.write(spSer(value));
    f.close();
}
// Names of an AE object's properties and methods
function spReflect(obj) {
    var r = {props: [], methods: []};
    try { var p = obj.reflect.properties; for (var i = 0; i < p.length; i++) r.props.push(String(p[i].name)); } catch (e) { r.propsError = String(e); }
    try { var m = obj.reflect.methods; for (var j = 0; j < m.length; j++) r.methods.push(String(m[j].name)); } catch (e2) { r.methodsError = String(e2); }
    return r;
}
// Values of the properties whose names match a pattern
var SP_COLOUR = /colou?r|ocio|space|profile|linear|gamma|lut|working|display|view|transform|alpha|premul|frameRate|conform|bits/i;
function spValues(obj, pattern) {
    var out = {};
    var names = spReflect(obj).props;
    for (var i = 0; i < names.length; i++) {
        if (pattern && !pattern.test(names[i])) continue;
        if (names[i] === "unique_id" || names[i] === "__proto__") continue;
        try { var v = obj[names[i]]; out[names[i]] = (v === null || typeof v === "number" || typeof v === "boolean" || typeof v === "string") ? v : String(v); }
        catch (e) { out[names[i]] = "<error: " + e + ">"; }
    }
    return out;
}
function spStep(R, name, fn) {
    try { var v = fn(); R.steps.push({name: name, ok: true, value: v === undefined ? null : v}); return v; }
    catch (e) { R.steps.push({name: name, ok: false, error: String(e) + (e.line ? " (line " + e.line + ")" : "")}); return null; }
}
function spCompByName(name) {
    for (var i = 1; i <= app.project.numItems; i++) {
        var it = app.project.item(i);
        if (it instanceof CompItem && it.name === name) return it;
    }
    return null;
}
